<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../common.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Franz.Common.Business" />
    <PackageReference Include="Franz.Common.Hosting" />
    <PackageReference Include="Franz.Common.Http.EntityFramework" />
    <PackageReference Include="Franz.Common.Mediator" />
    <PackageReference Include="Franz.Common.Messaging.Bootstrap" />
    <PackageReference Include="Franz.Common.Messaging.EntityFramework" />
    <PackageReference Include="Franz.Common.Messaging.Hosting.Kafka" />
    <PackageReference Include="Franz.Common.Messaging.KafKa" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbita.Application\Orbita.Application.csproj" />
    <ProjectReference Include="..\Orbita.Persistence\Orbita.Persistence.csproj" />
  </ItemGroup>

</Project>
